# Server
HOST=0.0.0.0
PORT=3005
BASE_PATH=/

# Auth
AUTH_USERNAME=admin
# Generate with: node -e "const crypto = require('crypto'); const salt = crypto.randomBytes(16).toString('hex'); const hash = crypto.scryptSync('YOUR_PASSWORD', Buffer.from(salt,'hex'), 64).toString('hex'); console.log('AUTH_PASSWORD_SALT=' + salt); console.log('AUTH_PASSWORD_HASH=' + hash);"
AUTH_PASSWORD_SALT=change_me
AUTH_PASSWORD_HASH=change_me

# Session
SESSION_TTL_MS=28800000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_with_a_random_32_character_secret

# Rate limiting
AUTH_MIN_RESPONSE_MS=900
LOGIN_WINDOW_MS=600000
LOGIN_MAX_REQUESTS=12
LOGIN_FAILURE_WINDOW_MS=1800000
LOGIN_MAX_LOCKOUT_MS=43200000
UNAUTH_WINDOW_MS=60000
UNAUTH_MAX_REQUESTS=10
UNAUTH_PENALTY_MS=5000

# Cookies / proxy
COOKIE_SECURE=auto
TRUST_PROXY=0

# Logs
MAX_LOG_BYTES_PER_FILE=5242880

# Monitoring retention
METRICS_RETENTION_MS=86400000
LOGS_RETENTION_MS=1209600000

# Database
SQLITE_DB_PATH=./data/pm2-process-web-ui.db

# Deployments
DEPLOY_BASE_DIR=./apps

# Ops
OPS_APPS_PATH=/home/seba/projects/
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxx
